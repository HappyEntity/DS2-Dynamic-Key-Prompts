root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,tsv}]
trim_trailing_whitespace = false

[*.{csproj,vcxproj,slnx,xml}]
indent_size = 2

[third_party/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
